<?xml version="1.0" encoding="utf-8"?>
<!-- Energy trading history: same collapsing bg-image header + sliding white sheet as transfer history -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_deep">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/login_deep"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/login_deep"
            app:titleEnabled="false">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg7"
                android:scaleType="centerCrop"
                android:contentDescription="Solar header"
                app:layout_collapseMode="parallax" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80063127"
                app:layout_collapseMode="parallax" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="48dp"
                app:layout_collapseMode="parallax">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Trading History"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your completed and upcoming reservations"
                    android:textSize="12sp"
                    android:textColor="@color/transfer_teal_pale"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- White sheet: scrolls up above the image -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_register_sheet"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:behavior_overlapTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Stats Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neuro_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total traded"
                        android:textSize="11sp"
                        android:textColor="@color/transfer_teal_pale"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:id="@+id/tv_total_traded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="26.0"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-semibold"
                            android:textColor="@color/text_brand"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" kWh"
                            android:textSize="12sp"
                            android:textColor="@color/transfer_teal_soft"
                            android:layout_marginBottom="3dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neuro_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total value"
                        android:textSize="11sp"
                        android:textColor="@color/transfer_teal_pale"/>
                    <TextView
                        android:id="@+id/tv_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 50.00"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-semibold"
                        android:textColor="@color/text_teal"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find a reservation"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#063127"
                android:layout_marginBottom="12dp"/>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_line_search"
                    android:contentDescription="Search" />
                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/neuro_text_primary"
                    android:textSize="14sp"
                    android:hint="Search code or station..."/>
            </LinearLayout>

            <!-- Status Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tabs_dark"
                    android:padding="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tab_all"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="All Statuses"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_tab_selected_pale"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tab_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Completed"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/tab_approved"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Approved"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/tab_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Pending"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/tab_cancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Cancelled"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <com.smartsolar.mobile.ui.common.LoadingDotsView
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No energy bookings found."
                android:textColor="@color/transfer_teal_soft"
                android:textSize="14sp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="24dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_bookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back button (unchanged style, fixed on top) -->
    <FrameLayout
        android:id="@+id/btn_back_header"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_neuro_icon_circle"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_line_back_arrow"
            android:contentDescription="Back" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
