<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation tracking card like reference Current Tracking card.
     No images: dots and lines are plain Views. Palette only green shades. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="7dp"
    android:background="@drawable/bg_booking_card"
    android:padding="16dp">

    <!-- Row 1: Tracking ID + status chip like "In Transit" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservation ID:"
                android:textSize="11sp"
                android:textColor="#65998B" />
            <TextView
                android:id="@+id/tv_booking_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAQ-327-P21"
                android:textSize="14sp"
                android:fontFamily="sans-serif-semibold"
                android:textColor="#063127"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_booking_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:fontFamily="sans-serif-medium"
            android:textColor="#063127"
            android:background="@drawable/bg_booking_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 2: From / To like reference -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From:"
                android:textSize="11sp"
                android:textColor="#65998B" />
            <TextView
                android:id="@+id/tv_booking_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prosumer Name"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#063127"
                android:layout_marginTop="2dp" />
            <!-- Kept for adapter compatibility (prosumer + NIC) -->
            <TextView
                android:id="@+id/tv_booking_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIC"
                android:textSize="11sp"
                android:textColor="#8FB3A9"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To:"
                android:textSize="11sp"
                android:textColor="#65998B" />
            <TextView
                android:id="@+id/tv_booking_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar Hub"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#063127"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/tv_booking_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-09-23 08:30"
                android:textSize="11sp"
                android:textColor="#8FB3A9"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Energy"
                android:textSize="11sp"
                android:textColor="#65998B" />
            <TextView
                android:id="@+id/tv_booking_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.0 kWh"
                android:textSize="13sp"
                android:fontFamily="sans-serif-semibold"
                android:textColor="#063127"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/tv_booking_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="1sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: status tracker like Received / In Transit / Delivered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/view_dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_track_dot_done" />

        <View
            android:id="@+id/view_line_1"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#063127" />

        <View
            android:id="@+id/view_dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_track_dot_current" />

        <View
            android:id="@+id/view_line_2"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:background="#BFD5D0" />

        <View
            android:id="@+id/view_dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_track_dot_todo" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requested"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#063127" />
            <TextView
                android:id="@+id/tv_track_sub_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="10sp"
                android:textColor="#8FB3A9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#063127"
                android:gravity="center" />
            <TextView
                android:id="@+id/tv_track_sub_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verified"
                android:textSize="10sp"
                android:textColor="#8FB3A9"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#063127"
                android:gravity="end" />
            <TextView
                android:id="@+id/tv_track_sub_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivered"
                android:textSize="10sp"
                android:textColor="#8FB3A9"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
