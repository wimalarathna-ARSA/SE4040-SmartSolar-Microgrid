<?xml version="1.0" encoding="utf-8"?>
<!-- Confirm reservation sheet: white, round margins, green text palette only:
     #BFD5D0 dividers, #8FB3A9 handle, #65998B labels, #3B796A accents, #063127 titles -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_confirm_booking"
    android:scrollbars="none"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_adjust_handle"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="PLEASE CONFIRM"
        android:textSize="10sp"
        android:letterSpacing="0.18"
        android:fontFamily="sans-serif-medium"
        android:textColor="#65998B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Confirm Reservation"
        android:textSize="20sp"
        android:fontFamily="sans-serif-semibold"
        android:textColor="#063127"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Book this energy slot?"
        android:textSize="12sp"
        android:textColor="#3B796A"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Detail rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Station"
            android:textSize="13sp"
            android:textColor="#65998B" />
        <TextView
            android:id="@+id/tv_confirm_station"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BFD5D0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Battery slot"
            android:textSize="13sp"
            android:textColor="#65998B" />
        <TextView
            android:id="@+id/tv_confirm_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BFD5D0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scheduled"
            android:textSize="13sp"
            android:textColor="#65998B" />
        <TextView
            android:id="@+id/tv_confirm_scheduled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BFD5D0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Energy"
            android:textSize="13sp"
            android:textColor="#65998B" />
        <TextView
            android:id="@+id/tv_confirm_energy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#BFD5D0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:layout_marginBottom="18dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Type"
            android:textSize="13sp"
            android:textColor="#65998B" />
        <TextView
            android:id="@+id/tv_confirm_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#3B796A"
            android:background="@drawable/bg_booking_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- Deep-green confirm pill -->
    <FrameLayout
        android:id="@+id/btn_confirm_go"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_save_dark_pill"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Confirm &amp; Generate QR"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/btn_confirm_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Cancel"
        android:textSize="13sp"
        android:textColor="#3B796A"
        android:padding="12dp" />

</LinearLayout>
</ScrollView>
