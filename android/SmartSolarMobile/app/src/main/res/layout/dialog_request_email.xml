<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neuro_card"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_neuro_icon_circle">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_line_mail"
                app:tint="@color/neuro_blue"
                android:contentDescription="Mail" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request Email Update"
                android:textSize="17sp"
                android:fontFamily="sans-serif-semibold"
                android:textColor="@color/neuro_text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backoffice approval required"
                android:textSize="11sp"
                android:textColor="@color/neuro_text_muted"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit a request to Backoffice to grant permission for changing your registered email address."
        android:textSize="12sp"
        android:textColor="@color/neuro_text_secondary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desired new email (optional)"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/neuro_text_primary"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_neuro_inner_card"
        android:paddingHorizontal="14dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <EditText
            android:id="@+id/et_dialog_requested_email"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:textColor="@color/neuro_text_primary"
            android:textSize="13sp"
            android:hint="new.email@solar.lk"
            android:inputType="textEmailAddress"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reason for change"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/neuro_text_primary"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_neuro_inner_card"
        android:padding="12dp"
        android:layout_marginBottom="20dp">
        <EditText
            android:id="@+id/et_dialog_reason"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:textColor="@color/neuro_text_primary"
            android:textSize="13sp"
            android:hint="e.g. Changed personal email..."
            android:gravity="top"
            android:inputType="textMultiLine"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_submit_request"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Submit Request to Backoffice"
        android:textSize="13sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/text_on_violet"
        android:background="@drawable/bg_btn_violet"
        app:backgroundTint="@null"
        app:cornerRadius="25dp"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/white"
        android:background="@drawable/bg_btn_solid_deep"
        app:backgroundTint="@null"
        app:cornerRadius="14dp"
        android:textAllCaps="false"/>

</LinearLayout>
