<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     File: activity_booking_detail.xml
     Description: Booking ticket pass like the flight-ticket reference — dark
                  header with booking ID, white perforated ticket card with the
                  same reservation details, QR pass and action buttons.
     ============================================================================ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#063127"
    android:padding="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header: back | Booking ID | spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:id="@+id/btn_back_header"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neuro_icon_circle"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_line_back_arrow"
                    android:contentDescription="Back" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textColor="@color/white" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_summary_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Pass"
            android:textSize="22sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp" />

        <!-- Error Banner -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neuro_danger"
            android:background="@color/neuro_danger_bg"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <com.smartsolar.mobile.ui.common.LoadingDotsView
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Ticket card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- Hub | Slot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOLAR HUB"
                            android:textSize="10sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#8FB3A9" />
                        <TextView
                            android:id="@+id/tv_station"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="#063127"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BATTERY SLOT"
                            android:textSize="10sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#8FB3A9" />
                        <TextView
                            android:id="@+id/tv_slot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Slot: Not Assigned"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="#063127"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#BFD5D0"
                    android:layout_marginBottom="14dp" />

                <!-- Schedule -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCHEDULE"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#8FB3A9" />
                <TextView
                    android:id="@+id/tv_scheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="#063127"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- Energy | Value -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENERGY"
                            android:textSize="10sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#8FB3A9" />
                        <TextView
                            android:id="@+id/tv_energy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="#063127"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTIMATED VALUE"
                            android:textSize="10sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#8FB3A9" />
                        <TextView
                            android:id="@+id/tv_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="#063127"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Type | Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TYPE"
                            android:textSize="10sp"
                            android:letterSpacing="0.12"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#8FB3A9" />
                        <TextView
                            android:id="@+id/tv_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="#063127"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Booking status tracker -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOOKING TRACKER"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#8FB3A9"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layout_status_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Perforation divider -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="-28dp"
            android:layout_marginBottom="-4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/bg_ticket_dash" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_notch" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_notch" />
        </RelativeLayout>

        <!-- QR stub card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@color/white"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_qr_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#65998B"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:visibility="gone"
                        android:contentDescription="Reservation QR Code" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Edit Reservation (12-hr rule)"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_ticket_outline"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel Reservation (12-hr rule)"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_on_danger"
            android:background="@drawable/bg_btn_danger"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Return"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:background="@drawable/bg_ticket_primary"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
