<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_canvas"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/btn_back_header"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neuro_icon_circle"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_line_back_arrow"
                    android:contentDescription="Back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prosumer profile"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/text_brand"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep your contact and installation details current"
                    android:textSize="12sp"
                    android:textColor="#65998B"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Identity header: deep-green account overview (photo cover removed) -->
        <LinearLayout
            android:id="@+id/profile_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_identity"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT OVERVIEW"
                android:textColor="#8FB3A9"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile and installation settings"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Profile Info Card -->
        <LinearLayout
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neuro_card"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_neuro_icon_circle">
                    <TextView
                        android:id="@+id/tv_avatar_initials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="AW"
                        android:textColor="@color/text_brand"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_header_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ARSA Wimalarathna"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-semibold"
                            android:textColor="@color/text_brand"/>
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_neuro_fab"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:id="@+id/tv_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textColor="#3B796A"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_role_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:background="@drawable/bg_role_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tv_nic_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIC: 200155600616"
                        android:textColor="#65998B"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_line_mail"
                    app:tint="#3B796A"
                    android:contentDescription="Email" />
                <TextView
                    android:id="@+id/tv_email_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="wwimalarathnasammani@gmail.com"
                    android:textColor="@color/text_brand"
                    android:textSize="13sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy"
                    android:textColor="#65998B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Email Security & Update Management Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neuro_card"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_neuro_icon_circle">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_line_mail"
                        app:tint="@color/text_brand"
                        android:contentDescription="Mail" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account email address"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-semibold"
                        android:textColor="@color/text_brand"/>

                    <TextView
                        android:id="@+id/tv_email_rate_limit_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Updates in last 24h: 0 / 3"
                        android:textSize="11sp"
                        android:textColor="#65998B"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_email_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locked"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/neuro_text_secondary"
                    android:background="@drawable/bg_neuro_badge_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

            <!-- Current Email Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current: "
                    android:textColor="#65998B"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_email_card_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="prosumer@solar.lk"
                    android:textColor="@color/text_brand"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- Rate Limit Alert Banner (shows when updates in 24h >= 3) -->
            <LinearLayout
                android:id="@+id/layout_email_rate_limit_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/neuro_danger_bg"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update limit reached"
                        android:textColor="@color/neuro_danger_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email can only be updated 3 times within 24 hours. Please try later."
                        android:textColor="@color/neuro_danger_dark"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Pending Review Banner (shows when request is pending Backoffice) -->
            <LinearLayout
                android:id="@+id/layout_email_pending_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/neuro_amber_bg"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending review"
                        android:textColor="@color/text_brand"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"/>
                    <TextView
                        android:id="@+id/tv_email_pending_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email update request submitted. Awaiting Backoffice officer approval."
                        android:textColor="@color/neuro_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Access Granted Section (shows when Backoffice has approved and given access) -->
            <LinearLayout
                android:id="@+id/layout_email_access_granted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/neuro_green_bg"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_line_check_circle"
                        android:contentDescription="Approved" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Backoffice granted access! You can now enter your new email address."
                        android:textColor="@color/neuro_text_green"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New email address"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_brand"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_neuro_inner_card"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_line_mail"
                        app:tint="#3B796A"
                        android:contentDescription="Mail" />
                    <EditText
                        android:id="@+id/et_new_email"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/text_brand"
                        android:textSize="14sp"
                        android:hint="Enter new email address..."
                        android:inputType="textEmailAddress"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_email_update"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Confirm and update email"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_on_accent"
                    android:background="@drawable/bg_btn_solid_deep"
                    app:backgroundTint="@null"
                    app:cornerRadius="26dp"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- Standard Request Access Button (shown when no access granted and not pending) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_email_update"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Request email update access"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_accent"
                android:background="@drawable/bg_btn_solid_deep"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Your Details Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neuro_card"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your details"
                android:textSize="18sp"
                android:fontFamily="sans-serif-semibold"
                android:textColor="@color/text_brand"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="These details help us manage your energy reservations."
                android:textSize="12sp"
                android:textColor="#65998B"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_brand"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="As shown on your account"
                android:textSize="11sp"
                android:textColor="#65998B"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_line_person"
                    app:tint="#3B796A"
                    android:contentDescription="Name" />
                <EditText
                    android:id="@+id/et_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_brand"
                    android:textSize="14sp"
                    android:hint="ARSA wimalarathna"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone number"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_brand"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used for important reservation updates"
                android:textSize="11sp"
                android:textColor="#65998B"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_line_phone"
                    app:tint="#3B796A"
                    android:contentDescription="Phone" />
                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_brand"
                    android:textSize="14sp"
                    android:hint="0741187495"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar installation address"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_brand"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The location connected to your solar hub"
                android:textSize="11sp"
                android:textColor="#65998B"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_line_location"
                    app:tint="#3B796A"
                    android:contentDescription="Address" />
                <EditText
                    android:id="@+id/et_address"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_brand"
                    android:textSize="14sp"
                    android:hint="waragoda, kelaniya"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_profile_location"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Choose location on map / Search"
                android:textAllCaps="false"
                android:textColor="@color/text_brand"
                android:background="@drawable/bg_btn_glass"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                android:layout_marginTop="-14dp"
                android:layout_marginBottom="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save profile updates"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_accent"
                android:background="@drawable/bg_btn_solid_deep"
                app:backgroundTint="@null"
                app:cornerRadius="28dp"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Account Deactivation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neuro_card"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_neuro_icon_circle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="!"
                        android:textColor="@color/neuro_danger"
                        android:textSize="16sp"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account deactivation"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_danger"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tell us why you would like to deactivate your node. Our support team will review your request before making any changes."
                android:textSize="12sp"
                android:textColor="@color/neuro_text_secondary"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:background="@drawable/bg_neuro_inner_card"
                android:padding="16dp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_line_mail"
                    android:contentDescription="Reason"
                    android:layout_marginTop="2dp"/>
                <EditText
                    android:id="@+id/et_deactivation_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_brand"
                    android:textSize="13sp"
                    android:hint="Reason for deactivation..."
                    android:gravity="top"
                    android:inputType="textMultiLine"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_deactivation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Request deactivation"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_danger"
                android:background="@drawable/bg_btn_danger"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                android:textAllCaps="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neuro_danger"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/tv_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#3B796A"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>
        <com.smartsolar.mobile.ui.common.LoadingDotsView
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
