<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_canvas">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/analytics_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/btn_back_header"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_neuro_icon_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_line_back_arrow"
                        android:contentDescription="Back" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energy Analytics"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-semibold"
                        android:textColor="@color/neuro_text_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data-driven grid insights"
                        android:textSize="12sp"
                        android:textColor="@color/neuro_text_muted"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 1. Booking Status - Pie Chart -->
            <LinearLayout
                android:id="@+id/card_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Status Distribution"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="16dp" />
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/chart_booking_status"
                    android:layout_width="match_parent"
                    android:layout_height="240dp" />
            </LinearLayout>

            <!-- 2. Weekly Energy Usage - fan gauge like reference -->
            <LinearLayout
                android:id="@+id/card_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Energy Usage"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tv_weekly_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kWh transferred per day (Current Week)"
                    android:textSize="11sp"
                    android:textColor="@color/neuro_text_muted"
                    android:layout_marginBottom="8dp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp">
                    <com.smartsolar.mobile.ui.common.FanGaugeView
                        android:id="@+id/gauge_weekly"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="14dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:id="@+id/tv_gauge_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="26sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textColor="@color/text_brand" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 3. Monthly Energy Summary - segmented share bars like reference -->
            <LinearLayout
                android:id="@+id/card_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Energy Summary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Month"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="16dp" />
                <LinearLayout
                    android:id="@+id/layout_monthly_segments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 4. Node Utilization Trends - weekday heatmap like reference -->
            <LinearLayout
                android:id="@+id/card_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Node Utilization Trends"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed kWh per hub, this week"
                    android:textSize="11sp"
                    android:textColor="@color/neuro_text_muted"
                    android:layout_marginBottom="12dp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/layout_node_legend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
                <LinearLayout
                    android:id="@+id/layout_node_heatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.smartsolar.mobile.ui.common.LoadingDotsView
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
