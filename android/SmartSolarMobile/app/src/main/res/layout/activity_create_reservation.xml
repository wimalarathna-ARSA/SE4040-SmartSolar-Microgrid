<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     File: activity_create_reservation.xml
     Description: Booking Slot Creation in transfer-history style — collapsing
                  bg5 header with titles, white sheet with the reservation form.
     ============================================================================ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_deep">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/login_deep"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/login_deep"
            app:titleEnabled="false">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg5"
                android:scaleType="centerCrop"
                android:contentDescription="Solar header"
                app:layout_collapseMode="parallax" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80063127"
                app:layout_collapseMode="parallax" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="48dp"
                app:layout_collapseMode="parallax">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Energy Reservation"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select node, type, energy and schedule"
                    android:textSize="12sp"
                    android:textColor="@color/transfer_teal_pale"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- White sheet: scrolls up above the image -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_register_sheet"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:behavior_overlapTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Error & Success Banners -->
            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/neuro_danger"
                android:background="@color/neuro_danger_bg"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/neuro_text_green"
                android:background="@color/neuro_green_bg"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Raised Glassmorphic Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <!-- Target Solar Node -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Solar Microgrid Node"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinner_station"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_underline"
                    android:paddingHorizontal="4dp"
                    android:layout_marginBottom="18dp"/>

                <!-- Reservation Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Type"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinner_type"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/reservation_types"
                    android:background="@drawable/bg_input_underline"
                    android:paddingHorizontal="4dp"
                    android:layout_marginBottom="18dp"/>

                <!-- Energy Amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Amount (kWh)"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_energy_kwh"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 15.5"
                    android:background="@drawable/bg_input_underline"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/neuro_text_primary"
                    android:textColorHint="@color/neuro_text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="18dp"/>

                <!-- Duration -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot Duration (Hours)"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_duration"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:inputType="number"
                    android:hint="e.g. 1"
                    android:text="1"
                    android:background="@drawable/bg_input_underline"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/neuro_text_primary"
                    android:textColorHint="@color/neuro_text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="18dp"/>

                <!-- Schedule Selection -->
                <TextView
                    android:id="@+id/tv_selected_datetime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Schedule: Not Selected"
                    android:textColor="@color/neuro_text_green"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_date"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Pick Date &amp; Time"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_ticket_primary"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Max 7 Days Ahead)"
                    android:textSize="11sp"
                    android:textColor="@color/neuro_text_muted"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <!-- Physical Slot Selection Grid -->
                <TextView
                    android:id="@+id/tv_slot_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Available Battery Slot"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="12dp"/>

                <GridLayout
                    android:id="@+id/grid_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:alignmentMode="alignMargins"
                    android:rowOrderPreserved="false"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_selected_slot_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap a green slot to select it."
                    android:textSize="11sp"
                    android:textColor="@color/neuro_text_muted"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <com.smartsolar.mobile.ui.common.LoadingDotsView
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Confirm &amp; Generate QR Pass"
                android:textSize="14sp"
                android:fontFamily="sans-serif-semibold"
                android:textColor="@color/text_on_accent"
                android:background="@drawable/bg_btn_primary"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back button (unchanged style, fixed on top) -->
    <FrameLayout
        android:id="@+id/btn_back_header"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_neuro_icon_circle"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_line_back_arrow"
            android:contentDescription="Back" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
