<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_canvas">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="12dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textColor="@color/neuro_text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_subtitle"
                        android:textColor="@color/neuro_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_neuro_icon_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_line_settings"
                        android:contentDescription="Settings" />
                </FrameLayout>
            </LinearLayout>

            <!-- Dashboard photo hero: real solar-house imagery + slate scrim.
                 Replace house_solar_4.xml placeholder with house_solar_4.png
                 (your 4th image) in drawable-nodpi/ for the final look. -->
            <FrameLayout
                android:id="@+id/dashboard_banner"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:background="@drawable/bg_neuro_card"
                android:layout_marginBottom="20dp"
                android:clipChildren="true">

                <ImageView
                    android:id="@+id/iv_dashboard_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/house_solar_4"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_thumb_photo"
                    android:contentDescription="Solar homes powered by SmartSolar" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_photo_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOLAR ENERGY NETWORK"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:letterSpacing="0.14"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your rooftop, connected to the grid"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-semibold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Live hub telemetry"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_neuro_icon_circle">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_battery_charging"
                                android:contentDescription="Network status" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Energy Transfer History Chart Section -->
            <LinearLayout
                android:id="@+id/energy_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neuro_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Transfer History"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-semibold"
                    android:textColor="@color/neuro_text_primary"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily kWh transferred through grid nodes"
                    android:textSize="12sp"
                    android:textColor="@color/neuro_text_muted"
                    android:layout_marginBottom="16dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/energy_line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>

            <!-- Your Slots Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_your_slots"
                android:textColor="@color/neuro_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_trading_activity"
                android:textColor="@color/neuro_text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Booking summary: one structured section card -->
            <LinearLayout
                android:id="@+id/slots_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_neuro_card"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_neuro_icon_circle"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_line_pulse"
                                android:contentDescription="Active" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tv_active_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/neuro_text_green"
                            android:textSize="28sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_active"
                            android:textColor="@color/neuro_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_active_sub"
                            android:textColor="@color/neuro_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_neuro_icon_circle"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_line_clock"
                                android:contentDescription="Pending" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tv_pending_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/neuro_amber"
                            android:textSize="28sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_pending"
                            android:textColor="@color/neuro_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_pending_sub"
                            android:textColor="@color/neuro_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_neuro_icon_circle"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_line_calendar"
                                android:contentDescription="Approved" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tv_approved_future"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/neuro_blue"
                            android:textSize="28sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_approved"
                            android:textColor="@color/neuro_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_approved_sub"
                            android:textColor="@color/neuro_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_neuro_icon_circle"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_line_check_circle"
                                android:contentDescription="Completed" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tv_completed_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/neuro_text_green"
                            android:textSize="28sp"
                            android:fontFamily="sans-serif-semibold"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_completed"
                            android:textColor="@color/neuro_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/slot_completed_sub"
                            android:textColor="@color/neuro_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Actions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_actions"
                android:textColor="@color/neuro_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:id="@+id/btn_analytics"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_neuro_btn_outline"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Analytics"
                    android:textColor="@color/neuro_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_transfers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_neuro_btn_outline"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfer History"
                    android:textColor="@color/neuro_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════════
                 NEARBY MICROGRID NODES SECTION
                 Populated programmatically in ProsumerMainActivity
                 ══════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEAR YOU"
                android:textColor="@color/neuro_text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby microgrid nodes"
                android:textColor="@color/neuro_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active hubs near your solar installation address"
                android:textColor="@color/neuro_text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Nearby nodes loading indicator -->
            <com.smartsolar.mobile.ui.common.LoadingDotsView
                android:id="@+id/progress_nearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- No-GPS notice -->
            <LinearLayout
                android:id="@+id/layout_no_gps_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_neuro_inner_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No installation GPS set"
                    android:textColor="@color/neuro_amber"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set your solar installation coordinates during registration or via Profile to see personalised nearby hub distances."
                    android:textColor="@color/neuro_text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Dynamic nearby hub cards injected here by Java -->
            <LinearLayout
                android:id="@+id/layout_nearby_nodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:layout_marginBottom="16dp"/>

            <com.smartsolar.mobile.ui.common.LoadingDotsView
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Bottom Navigation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_neuro_nav_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">
            <LinearLayout
                android:id="@+id/nav_dashboard"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_neuro_nav_item_selected"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_dashboard"
                    android:contentDescription="Dashboard" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_dashboard"
                    android:textColor="@color/neuro_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nav_bookings"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_bookings"
                    android:contentDescription="Bookings" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_bookings"
                    android:textColor="@color/neuro_nav_unselected"
                    android:textSize="10sp" />
            </LinearLayout>
            <View
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp" />
            <LinearLayout
                android:id="@+id/nav_map"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_hubs"
                    android:contentDescription="Hubs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_hubs"
                    android:textColor="@color/neuro_nav_unselected"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="Profile" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_profile"
                    android:textColor="@color/neuro_nav_unselected"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/nav_new_booking"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@drawable/bg_neuro_fab"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_new_booking"
            android:elevation="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="@color/text_on_accent"
                android:textSize="34sp"
                android:fontFamily="sans-serif-light" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>