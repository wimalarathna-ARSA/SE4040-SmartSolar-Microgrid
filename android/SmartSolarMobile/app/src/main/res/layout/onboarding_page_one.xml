<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding Screen 1: full-bleed rounded photo card like reference.
     Background: onboard1.jpeg (aerial solar + lake). Title top-center white,
     frosted pill + white GO circle bottom-center (Next), Skip top-right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/onboard1"
                android:scaleType="centerCrop"
                android:contentDescription="@string/onboarding_illustration_desc" />

            <!-- Legibility scrims -->
            <View
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_onboarding_top_scrim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_bottom_scrim" />

            <!-- Title block: top-center -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="28dp"
                android:paddingTop="52dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding1_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding1_desc"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Skip: top-right, subtle white -->
            <TextView
                android:id="@+id/btn_onboarding_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/onboarding_skip"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <!-- GO pill: bottom-center -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="30dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_onboarding_hero_pill"
                android:paddingHorizontal="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_onboarding_chev_up"
                    android:contentDescription="@string/onboarding_next"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/btn_onboarding_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_onboarding_go_circle"
                    android:gravity="center"
                    android:text="@string/onboarding_go"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
