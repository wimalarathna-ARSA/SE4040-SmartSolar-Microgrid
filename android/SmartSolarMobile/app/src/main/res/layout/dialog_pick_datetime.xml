<?xml version="1.0" encoding="utf-8"?>
<!-- Pick Date &amp; Time sheet styled exactly like the operator Adjust Slots dialog:
     #BFD5D0 card, #8FB3A9 track/handle, #65998B secondary,
     #3B796A accents, #063127 titles. Segmented Date|Time mirrors Free|Total. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_edit_sheet_water"
    android:scrollbars="none"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_adjust_handle"
        android:layout_marginBottom="18dp" />

    <!-- Top status row (green dot + 7-day rule) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot_orange" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schedule Picker"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#3B796A"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max +7 days"
            android:textSize="13sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="SCHEDULE"
        android:textSize="10sp"
        android:letterSpacing="0.18"
        android:fontFamily="sans-serif-medium"
        android:textColor="#65998B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Pick Date &amp; Time"
        android:textSize="20sp"
        android:fontFamily="sans-serif-semibold"
        android:textColor="#063127"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp" />

    <!-- Segmented Date|Time control -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/bg_segment_track"
        android:padding="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_seg_date"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_segment_selected"
            android:text="Date"
            android:textSize="12sp"
            android:fontFamily="sans-serif-semibold"
            android:textColor="#063127"
            android:paddingHorizontal="22dp" />

        <TextView
            android:id="@+id/tv_seg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Time"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#3B796A"
            android:paddingHorizontal="22dp"
            android:minHeight="32dp" />
    </LinearLayout>

    <!-- Huge value -->
    <TextView
        android:id="@+id/tv_pick_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="23"
        android:textSize="72sp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="#063127"
        android:layout_marginTop="0dp" />

    <TextView
        android:id="@+id/tv_pick_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Tue, 23 Sep 2026"
        android:textSize="12sp"
        android:textColor="#3B796A"
        android:layout_marginBottom="16dp" />

    <!-- Day stepper row (Date mode only) -->
    <LinearLayout
        android:id="@+id/layout_day_stepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:id="@+id/btn_pick_minus"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_stepper_circle"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="−"
                android:textSize="26sp"
                android:textColor="#063127"
                android:includeFontPadding="false" />
        </FrameLayout>

        <View
            android:layout_width="20dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/btn_pick_plus"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_stepper_circle"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textSize="26sp"
                android:textColor="#063127"
                android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <!-- Analog clock circle (Time mode only) -->
    <LinearLayout
        android:id="@+id/layout_clock_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:visibility="gone">

        <TimePicker
            android:id="@+id/time_picker_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:timePickerMode="clock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the clock face to set time"
            android:textSize="12sp"
            android:textColor="#3B796A"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Deep-green pill save -->
    <FrameLayout
        android:id="@+id/btn_pick_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_save_dark_pill"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Save Schedule"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/btn_pick_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Cancel"
        android:textSize="13sp"
        android:textColor="#3B796A"
        android:padding="12dp" />

</LinearLayout>
</ScrollView>
