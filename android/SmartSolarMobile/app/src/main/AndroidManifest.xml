<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolar.Glass"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartSolar.Glass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:label="Prosumer Registration"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.ProsumerMainActivity"
            android:label="Solar Trading Dashboard"
            android:theme="@style/Theme.SmartSolar.Glass"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.CreateReservationActivity"
            android:label="Book Energy Slot"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.BookingDetailActivity"
            android:label="Booking Details"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.BookingHistoryActivity"
            android:label="Energy Booking History"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.EnergyTransferHistoryActivity"
            android:label="Energy Transfer History"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.AnalyticsActivity"
            android:label="Energy Analytics"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.StationMapActivity"
            android:label="Nearby Solar Stations"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.ProfileActivity"
            android:label="My Profile"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.SettingsActivity"
            android:label="Settings"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorMainActivity"
            android:label="Grid Operator Console"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorNodeDetailActivity"
            android:label="Node Telemetry Details"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorBookingDetailActivity"
            android:label="Booking Operational Audit"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorTransactionDetailActivity"
            android:label="Historical Transaction Audit"
            android:exported="false" />

        <activity
            android:name=".ui.operator.QrScannerActivity"
            android:label="QR Scanner &amp; Verifier"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorStationsActivity"
            android:label="Station Inspection"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorAnalyticsActivity"
            android:label="Fleet Analytics"
            android:exported="false" />

        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation"
            tools:ignore="SourceLockedOrientationActivity"
            android:stateNotNeeded="true"
            android:exported="false" />

    </application>
</manifest>
